@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var maTaiKhoan = session?.GetInt32("MaTaiKhoan");
    var hoTen = session?.GetString("HoTen");
    var vaiTro = session?.GetString("VaiTro");
    var currentMaHocVien = session?.GetInt32("MaHocVien");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trung Tâm Ngoại Ngữ UNETI</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-blue: #1e3a8a;
            --primary-hover: #1e40af;
            --accent-cyan: #0284c7;
            --accent-gold: #f59e0b;
            --bg-light: #f8fafc;
            --text-dark: #0f172a;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-uneti {
            background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        }

        .navbar-brand-title {
            font-weight: 800;
            font-size: 1.2rem;
            color: #ffffff !important;
            letter-spacing: -0.5px;
        }

        .navbar-brand-subtitle {
            font-size: 0.75rem;
            color: #93c5fd;
            display: block;
            margin-top: -3px;
        }

        .nav-link {
            font-weight: 500;
            color: #cbd5e1 !important;
            padding: 0.6rem 1rem !important;
            transition: all 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
        }

        .btn-gold {
            background-color: var(--accent-gold);
            color: #000000;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            padding: 0.5rem 1.25rem;
            transition: all 0.3s ease;
        }

        .btn-gold:hover {
            background-color: #d97706;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
        }

        .badge-role-admin {
            background-color: #ef4444;
            color: #ffffff;
            font-size: 0.7rem;
            padding: 0.2rem 0.5rem;
            border-radius: 12px;
        }

        .badge-role-student {
            background-color: #10b981;
            color: #ffffff;
            font-size: 0.7rem;
            padding: 0.2rem 0.5rem;
            border-radius: 12px;
        }

        .main-wrapper {
            flex: 1;
            padding-top: 1.5rem;
            padding-bottom: 3rem;
        }

        .card-custom {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            background: #ffffff;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .card-custom:hover {
            box-shadow: 0 8px 30px rgba(0,0,0,0.1);
        }

        .footer-uneti {
            background-color: #0f172a;
            color: #94a3b8;
            padding: 2.5rem 0 1.5rem 0;
            margin-top: auto;
            border-top: 1px solid #1e293b;
        }

        .page-header-banner {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            color: #ffffff;
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 25px rgba(30, 58, 138, 0.2);
        }

        .table-custom th {
            background-color: #f1f5f9;
            color: #334155;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #cbd5e1;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-uneti sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-graduation-cap fa-2x text-warning"></i>
                <div>
                    <span class="navbar-brand-title">TRUNG TÂM NGOẠI NGỮ UNETI</span>
                    <span class="navbar-brand-subtitle">Dự án UNETI04 - Lớp TI17A2HN</span>
                </div>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1"></i> Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="KhoaHoc" asp-action="Index"><i class="fa-solid fa-book-open me-1"></i> Khóa học</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="LopHoc" asp-action="Index"><i class="fa-solid fa-chalkboard-user me-1"></i> Lớp học</a>
                    </li>

                    @if (vaiTro == "HocVien")
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" asp-controller="DangKyHoc" asp-action="LichSuDangKy">
                                <i class="fa-solid fa-clock-rotate-left me-1"></i> Lịch sử đăng ký
                            </a>
                        </li>
                    }

                    @if (vaiTro == "Admin")
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-warning fw-bold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-user-shield me-1"></i> Quản trị Admin
                            </a>
                            <ul class="dropdown-menu shadow-lg border-0 rounded-3 mt-2">
                                <li><a class="dropdown-item py-2" asp-controller="ThongKe" asp-action="Dashboard"><i class="fa-solid fa-chart-line me-2 text-primary"></i> Dashboard</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="ThongKe" asp-action="Index"><i class="fa-solid fa-chart-pie me-2 text-success"></i> Thống kê báo cáo</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2" asp-controller="DangKyHoc" asp-action="Index"><i class="fa-solid fa-clipboard-check me-2 text-warning"></i> Quản lý Đăng ký học</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="KhoaHoc" asp-action="Index"><i class="fa-solid fa-book me-2 text-info"></i> Quản lý Khóa học</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="LopHoc" asp-action="Index"><i class="fa-solid fa-list-check me-2 text-primary"></i> Quản lý Lớp học</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="HocVien" asp-action="Index"><i class="fa-solid fa-users me-2 text-danger"></i> Quản lý Học viên</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="TaiKhoan" asp-action="Index"><i class="fa-solid fa-user-gear me-2 text-secondary"></i> Quản lý Tài khoản</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-2">
                    @if (maTaiKhoan.HasValue)
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-light dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3 py-1" type="button" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-circle-user fa-lg text-warning"></i>
                                <span class="fw-semibold small">@hoTen</span>
                                @if (vaiTro == "Admin")
                                {
                                    <span class="badge badge-role-admin">ADMIN</span>
                                }
                                else
                                {
                                    <span class="badge badge-role-student">HỌC VIÊN</span>
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                                <li><a class="dropdown-item py-2" asp-controller="TaiKhoan" asp-action="Profile"><i class="fa-solid fa-id-card me-2 text-primary"></i> Thông tin cá nhân</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger" asp-controller="TaiKhoan" asp-action="Logout"><i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-light rounded-pill px-3 py-1 fw-medium" asp-controller="TaiKhoan" asp-action="Login"><i class="fa-solid fa-right-to-bracket me-1"></i> Đăng nhập</a>
                        <a class="btn btn-gold rounded-pill px-3 py-1" asp-controller="TaiKhoan" asp-action="Register"><i class="fa-solid fa-user-plus me-1"></i> Đăng ký ngay</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="main-wrapper">
        <div class="container">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4 border-0 border-start border-success border-4" role="alert">
                    <i class="fa-solid fa-circle-check me-2 fa-lg"></i>
                    <strong>Thành công:</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4 border-0 border-start border-danger border-4" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2 fa-lg"></i>
                    <strong>Lỗi:</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <footer class="footer-uneti">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-graduation-cap text-warning me-2"></i>TRUNG TÂM NGOẠI NGỮ UNETI</h5>
                    <p class="small text-light-50">Dự án Bài tập lớn Môn Thực hành Lập trình .NET (ASP.NET Core 10 MVC & EF Core 10 Code First).</p>
                    <p class="small mb-1"><i class="fa-solid fa-location-dot me-2 text-warning"></i>Trường Đại học Kinh tế - Kỹ thuật Công nghiệp (UNETI)</p>
                    <p class="small mb-0"><i class="fa-solid fa-users me-2 text-warning"></i>Nhóm 04 - Lớp TI17A2HN</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-white fw-bold mb-3">ĐỊNH HƯỚNG ĐÀO TẠO</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="#" class="text-secondary text-decoration-none"><i class="fa-angle-right fa-solid me-2"></i>Tiếng Anh Giao Tiếp & IELTS</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none"><i class="fa-angle-right fa-solid me-2"></i>Tiếng Trung HSK 1-6</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none"><i class="fa-angle-right fa-solid me-2"></i>Tiếng Nhật JLPT N5 - N2</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none"><i class="fa-angle-right fa-solid me-2"></i>Tiếng Hàn TOPIK 1 - 4</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white fw-bold mb-3">THÀNH VIÊN THỰC HIỆN (NHÓM 04)</h6>
                    <div class="small text-secondary d-flex flex-column gap-1">
                        <div><strong class="text-light">SV 1:</strong> Phạm Văn Công - 23103100115 (Module 1)</div>
                        <div><strong class="text-light">SV 2:</strong> Trần Thị B - 22103100002 (Module 2)</div>
                        <div><strong class="text-light">SV 3:</strong> Lê Văn C - 22103100003 (Module 3)</div>
                        <div><strong class="text-light">SV 4:</strong> Phạm Thị D - 22103100004 (Module 4)</div>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="text-center small text-secondary">
                &copy; @DateTime.Now.Year QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
