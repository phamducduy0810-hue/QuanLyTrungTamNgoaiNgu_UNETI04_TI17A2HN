@*
    Họ và tên: Phạm Đức Duy
    Mã sinh viên: [Điền mã sinh viên của bạn]
    Nội dung thực hiện: Module 2 - Giao diện Xác nhận xóa lớp học (Delete)
*@
@model QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.LopHoc

@{
    ViewData["Title"] = "Xóa Lớp học";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>XÁC NHẬN XÓA LỚP HỌC</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa lớp học này không? Hành động này sẽ không thể khôi phục lại dữ liệu!
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Mã lớp học:</dt>
                        <dd class="col-sm-8 fw-bold">#@Model.MaLop</dd>

                        <dt class="col-sm-4 text-muted">Tên lớp học:</dt>
                        <dd class="col-sm-8 text-primary fw-bold">@Model.TenLop</dd>

                        <dt class="col-sm-4 text-muted">Khóa học:</dt>
                        <dd class="col-sm-8">@(Model.KhoaHoc?.TenKhoaHoc ?? "Không xác định")</dd>

                        <dt class="col-sm-4 text-muted">Khai giảng:</dt>
                        <dd class="col-sm-8">@Model.NgayKhaiGiang.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4 text-muted">Lịch học & Phòng:</dt>
                        <dd class="col-sm-8">@Model.LichHoc - @Model.PhongHoc</dd>

                        <dt class="col-sm-4 text-muted">Học phí:</dt>
                        <dd class="col-sm-8 text-danger fw-bold">@Model.HocPhi.ToString("N0") VNĐ</dd>

                        <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                        <dd class="col-sm-8">@Model.TrangThai</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light p-3 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="bi bi-arrow-left"></i> Hủy và Quay lại
                    </a>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="MaLop" />
                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                            <i class="bi bi-trash-fill me-1"></i> Xác nhận Xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
