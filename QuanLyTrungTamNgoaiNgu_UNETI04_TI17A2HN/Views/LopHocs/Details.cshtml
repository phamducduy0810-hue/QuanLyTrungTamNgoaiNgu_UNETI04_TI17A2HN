@*
    Họ và tên: Phạm Đức Duy
    Mã sinh viên: 23103100084
    Nội dung thực hiện: Module 2 - Giao diện Xem chi tiết lớp học (Details)
    Bổ sung: Danh sách học viên trong lớp & Xuất file Excel (.xlsx) điểm danh bằng ClosedXML
*@
@model QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.LopHoc

@{
    ViewData["Title"] = "Chi tiết Lớp học: " + Model.TenLop;
    var vaiTro = Context.Session.GetString("VaiTro");
    bool isAdmin = (vaiTro == "Admin");
    bool isGiangVien = (vaiTro == "GiangVien");
    int soLuongDaXacNhan = Model.DangKyHocs?.Count(d => d.TrangThai == "Đã xác nhận") ?? 0;
    int soLuongChoXacNhan = Model.DangKyHocs?.Count(d => d.TrangThai == "Chờ xác nhận") ?? 0;
    int tongSoDangKy = Model.DangKyHocs?.Count ?? 0;
}

<div class="container py-4">
    <!-- KHỐI 1: THÔNG TIN CHI TIẾT LỚP HỌC -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h4 class="mb-0 fw-bold">
                <i class="fa-solid fa-chalkboard-user me-2"></i>CHI TIẾT LỚP HỌC: @Model.TenLop
            </h4>
            <span class="badge bg-light text-primary fs-6 px-3 py-2 fw-bold">Mã lớp: #@Model.MaLop</span>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-6 border-end">
                    <h5 class="text-primary fw-bold mb-3 border-bottom pb-2">
                        <i class="fa-solid fa-book-open me-2"></i>Thông tin Khóa học & Lịch
                    </h5>
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">Khóa học:</dt>
                        <dd class="col-sm-7 fw-bold text-primary">@(Model.KhoaHoc?.TenKhoaHoc ?? "Không xác định")</dd>

                        <dt class="col-sm-5 text-muted">Ngoại ngữ:</dt>
                        <dd class="col-sm-7">@(Model.KhoaHoc?.NgoaiNgu ?? "Không xác định")</dd>

                        <dt class="col-sm-5 text-muted">Cấp độ:</dt>
                        <dd class="col-sm-7">@(Model.KhoaHoc?.CapDo ?? "Không xác định")</dd>

                        <dt class="col-sm-5 text-muted">Khai giảng:</dt>
                        <dd class="col-sm-7 fw-bold">@Model.NgayKhaiGiang.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-5 text-muted">Lịch học:</dt>
                        <dd class="col-sm-7"><span class="badge bg-secondary-subtle text-secondary-emphasis">@Model.LichHoc</span></dd>

                        <dt class="col-sm-5 text-muted">Phòng học:</dt>
                        <dd class="col-sm-7"><span class="badge bg-info-subtle text-info-emphasis">@Model.PhongHoc</span></dd>

                        <dt class="col-sm-5 text-muted">Giảng viên:</dt>
                        <dd class="col-sm-7 fw-bold text-success">
                            @if (Model.GiangVien != null)
                            {
                                <i class="fa-solid fa-person-chalkboard me-1"></i>@Model.GiangVien.HoTen
                            }
                            else
                            {
                                <span class="text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i>Chưa phân công</span>
                            }
                        </dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <h5 class="text-primary fw-bold mb-3 border-bottom pb-2">
                        <i class="fa-solid fa-coins me-2"></i>Học phí & Sĩ số
                    </h5>
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">Học phí:</dt>
                        <dd class="col-sm-7 text-danger fw-bold fs-5">@Model.HocPhi.ToString("N0") VNĐ</dd>

                        <dt class="col-sm-5 text-muted">Trạng thái lớp:</dt>
                        <dd class="col-sm-7">
                            @switch (Model.TrangThai)
                            {
                                case "Đang tuyển sinh":
                                    <span class="badge bg-success px-3 py-2">Đang tuyển sinh</span>
                                    break;
                                case "Sắp mở":
                                    <span class="badge bg-warning text-dark px-3 py-2">Sắp mở</span>
                                    break;
                                case "Đang học":
                                    <span class="badge bg-primary px-3 py-2">Đang học</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary px-3 py-2">Đã kết thúc</span>
                                    break;
                            }
                        </dd>

                        <dt class="col-sm-5 text-muted">Số lượng tối đa:</dt>
                        <dd class="col-sm-7">@Model.SoLuongToiDa học viên</dd>

                        <dt class="col-sm-5 text-muted">Sĩ số xác nhận:</dt>
                        <dd class="col-sm-7">
                            <span class="fw-bold text-success fs-6">@soLuongDaXacNhan</span> / @Model.SoLuongToiDa học viên
                            <div class="progress mt-2" style="height: 10px;">
                                <div class="progress-bar @(soLuongDaXacNhan >= Model.SoLuongToiDa ? "bg-danger" : "bg-success")" role="progressbar" 
                                     style="width: @((Model.SoLuongToiDa > 0) ? (soLuongDaXacNhan * 100 / Model.SoLuongToiDa) : 0)%;">
                                </div>
                            </div>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
            </a>
            <div class="d-flex flex-wrap gap-2">
                @if (isAdmin)
                {
                    <a asp-action="Edit" asp-route-id="@Model.MaLop" class="btn btn-warning px-3">
                        <i class="fa-solid fa-pen-to-square me-1"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.MaLop" class="btn btn-outline-danger px-3">
                        <i class="fa-solid fa-trash me-1"></i> Xóa
                    </a>
                }

                @if (Model.TrangThai == "Đang tuyển sinh" && soLuongDaXacNhan < Model.SoLuongToiDa)
                {
                    <a asp-controller="DangKyHoc" asp-action="DangKy" asp-route-maLop="@Model.MaLop" class="btn btn-success px-4 fw-bold shadow-sm">
                        <i class="fa-solid fa-paper-plane me-1"></i> Đăng ký lớp này
                    </a>
                }
                else
                {
                    <button class="btn btn-secondary px-3" disabled>Lớp tạm ngưng nhận học viên</button>
                }
            </div>
        </div>
    </div>

    <!-- KHỐI 2: DANH SÁCH HỌC VIÊN CỦA LỚP & XUẤT EXCEL -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
            <div>
                <h5 class="mb-0 fw-bold text-primary">
                    <i class="fa-solid fa-users me-2"></i>DANH SÁCH HỌC VIÊN CỦA LỚP HỌC
                </h5>
                <div class="small text-muted mt-1">
                    Tổng số đăng ký: <strong class="text-dark">@tongSoDangKy</strong> | 
                    Đã xác nhận: <strong class="text-success">@soLuongDaXacNhan</strong> học viên | 
                    Chờ xác nhận: <strong class="text-warning">@soLuongChoXacNhan</strong> học viên
                </div>
            </div>
            <div>
                <a asp-action="XuatDanhSachHocVienExcel" asp-route-id="@Model.MaLop" class="btn btn-success d-inline-flex align-items-center gap-2 shadow-sm px-3 py-2">
                    <i class="fa-solid fa-file-excel fs-5"></i>
                    <span class="fw-bold">Xuất danh sách ra Excel (.xlsx)</span>
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="text-center" style="width: 50px;">STT</th>
                            <th>Họ và tên</th>
                            <th>Giới tính</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th class="text-center">Ngày đăng ký</th>
                            <th class="text-end">Học phí</th>
                            <th class="text-center">Trạng thái đóng phí</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                            var dsDangKy = Model.DangKyHocs?.OrderBy(d => d.HocVien?.HoTen).ToList();
                        }
                        @if (dsDangKy != null && dsDangKy.Any())
                        {
                            @foreach (var item in dsDangKy)
                            {
                                <tr>
                                    <td class="text-center fw-semibold text-muted">@(stt++)</td>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            <i class="fa-solid fa-circle-user text-primary me-1"></i>
                                            @(item.HocVien?.HoTen ?? "Học viên #" + item.MaHocVien)
                                        </div>
                                        @if (item.HocVien?.NgaySinh != null)
                                        {
                                            <div class="small text-muted">
                                                <i class="fa-regular fa-calendar me-1"></i>Ngày sinh: @item.HocVien.NgaySinh.ToString("dd/MM/yyyy")
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (item.HocVien?.GioiTinh == "Nữ")
                                        {
                                            <span class="badge bg-danger-subtle text-danger"><i class="fa-solid fa-venus me-1"></i>Nữ</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary"><i class="fa-solid fa-mars me-1"></i>Nam</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="tel:@item.HocVien?.SoDienThoai" class="text-decoration-none text-dark fw-semibold">
                                            <i class="fa-solid fa-phone text-muted me-1 small"></i>@(item.HocVien?.SoDienThoai ?? "Chưa có")
                                        </a>
                                    </td>
                                    <td>
                                        <a href="mailto:@item.HocVien?.Email" class="text-decoration-none text-muted">
                                            <i class="fa-regular fa-envelope text-muted me-1 small"></i>@(item.HocVien?.Email ?? "Chưa có")
                                        </a>
                                    </td>
                                    <td class="text-center text-muted small">
                                        @item.NgayDangKy.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-end fw-bold text-dark">
                                        @item.HocPhi.ToString("N0") đ
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai == "Đã xác nhận")
                                        {
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="fa-solid fa-circle-check me-1"></i>Đã xác nhận
                                            </span>
                                        }
                                        else if (item.TrangThai == "Chờ xác nhận")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2">
                                                <i class="fa-solid fa-clock me-1"></i>Chờ xác nhận
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2">
                                                <i class="fa-solid fa-ban me-1"></i>Đã hủy
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-user-slash fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                    <span>Lớp học này hiện chưa có học viên nào đăng ký.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
