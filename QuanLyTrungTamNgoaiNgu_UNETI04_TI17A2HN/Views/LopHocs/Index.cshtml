@*
    Họ và tên: Phạm Đức Duy-23103100084    
    Nội dung thực hiện: Module 2 - Giao diện tra cứu lớp học (Tìm kiếm, Lọc, Sắp xếp, Phân trang) và Quản trị CRUD
*@
@model QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.LopHocIndexViewModel

@{
    ViewData["Title"] = "Quản lý & Tra cứu Lớp học";
    var vaiTro = Context.Session.GetString("VaiTro");
    bool isAdmin = (vaiTro == "Admin");
}

<div class="container py-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="text-primary fw-bold mb-1">
                <i class="bi bi-mortarboard-fill me-2"></i>QUẢN LÝ & TRA CỨU LỚP HỌC
            </h2>
            <p class="text-muted mb-0">Hệ thống tra cứu, lọc và quản trị lớp học dành cho Admin và Học viên</p>
        </div>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-success px-4 py-2 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Thêm Lớp học mới
            </a>
        }
    </div>

    <!-- THÔNG BÁO KẾT QUẢ THAO TÁC (SUCCESS / ERROR) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-4">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    
                    <!-- 1. TÌM KIẾM TỪ KHÓA -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">
                            <i class="bi bi-search text-primary me-1"></i>Từ khóa tìm kiếm
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" name="SearchKeyword" value="@Model.SearchKeyword" class="form-control" placeholder="Tên lớp hoặc khóa học..." />
                        </div>
                    </div>

                    <!-- 2. LỌC THEO KHÓA HỌC -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-book text-primary me-1"></i>Khóa học
                        </label>
                        <select name="MaKhoaHoc" class="form-select bg-white">
                            <option value="">-- Tất cả khóa học --</option>
                            @if (ViewBag.KhoaHocs != null)
                            {
                                foreach (var kh in (IEnumerable<QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.KhoaHoc>)ViewBag.KhoaHocs)
                                {
                                    <option value="@kh.MaKhoaHoc" selected="@(Model.MaKhoaHoc == kh.MaKhoaHoc ? "selected" : null)">
                                        @kh.TenKhoaHoc
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- 3. LỌC THEO NGOẠI NGỮ -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold">
                            <i class="bi bi-translate text-primary me-1"></i>Ngoại ngữ
                        </label>
                        <select name="NgoaiNgu" class="form-select bg-white">
                            <option value="">-- Tất cả --</option>
                            @if (ViewBag.NgoaiNgus != null)
                            {
                                foreach (var nn in (IEnumerable<string>)ViewBag.NgoaiNgus)
                                {
                                    <option value="@nn" selected="@(Model.NgoaiNgu == nn ? "selected" : null)">
                                        @nn
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- 4. LỌC THEO TRẠNG THÁI -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-tag text-primary me-1"></i>Trạng thái lớp
                        </label>
                        <select name="TrangThai" class="form-select bg-white">
                            <option value="">-- Tất cả trạng thái --</option>
                            @foreach (var tt in new[] { "Sắp mở", "Đang tuyển sinh", "Đang học", "Đã kết thúc" })
                            {
                                <option value="@tt" selected="@(Model.TrangThai == tt ? "selected" : null)">
                                    @tt
                                </option>
                            }
                        </select>
                    </div>

                    <!-- 5. KHOẢNG HỌC PHÍ TỪ -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-cash-stack text-success me-1"></i>Học phí từ (VNĐ)
                        </label>
                        <input type="text" 
                               inputmode="numeric" 
                               name="GiaTu" 
                               value="@(Model.GiaTu.HasValue ? Model.GiaTu.Value.ToString("N0") : "")" 
                               class="form-control bg-white" 
                               placeholder="VD: 1.000.000 hoặc 1000000" />
                    </div>

                    <!-- 6. KHOẢNG HỌC PHÍ ĐẾN -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-cash-stack text-danger me-1"></i>Học phí đến (VNĐ)
                        </label>
                        <input type="text" 
                               inputmode="numeric" 
                               name="GiaDen" 
                               value="@(Model.GiaDen.HasValue ? Model.GiaDen.Value.ToString("N0") : "")" 
                               class="form-control bg-white" 
                               placeholder="VD: 5.000.000 hoặc 5000000" />
                    </div>

                    <!-- 7. SẮP XẾP THEO -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-arrow-down-up text-primary me-1"></i>Sắp xếp theo
                        </label>
                        <select name="SortOrder" class="form-select bg-white">
                            <option value="name_asc" selected="@(Model.SortOrder == "name_asc")">Tên lớp A → Z</option>
                            <option value="name_desc" selected="@(Model.SortOrder == "name_desc")">Tên lớp Z → A</option>
                            <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Học phí Thấp → Cao</option>
                            <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Học phí Cao → Thấp</option>
                            <option value="date_asc" selected="@(Model.SortOrder == "date_asc")">Ngày khai giảng Tăng dần</option>
                            <option value="date_desc" selected="@(Model.SortOrder == "date_desc")">Ngày khai giảng Giảm dần</option>
                        </select>
                    </div>

                    <!-- NÚT ÁP DỤNG & RESET BỘ LỌC -->
                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                            <i class="bi bi-funnel-fill me-1"></i> Áp dụng Lọc
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2 px-3" title="Đặt lại toàn bộ bộ lọc">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>

                @{
                    bool hasActiveFilters = !string.IsNullOrWhiteSpace(Model.SearchKeyword) ||
                                            Model.MaKhoaHoc.HasValue ||
                                            !string.IsNullOrWhiteSpace(Model.NgoaiNgu) ||
                                            !string.IsNullOrWhiteSpace(Model.TrangThai) ||
                                            Model.GiaTu.HasValue ||
                                            Model.GiaDen.HasValue ||
                                            (!string.IsNullOrEmpty(Model.SortOrder) && Model.SortOrder != "name_asc");
                }

                @if (hasActiveFilters)
                {
                    <div class="mt-3 pt-3 border-top d-flex flex-wrap align-items-center gap-2">
                        <span class="small text-muted fw-bold me-1">
                            <i class="bi bi-check2-circle text-success me-1"></i>Điều kiện đang kết hợp lọc:
                        </span>
                        @if (!string.IsNullOrWhiteSpace(Model.SearchKeyword))
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                                Từ khóa: "@Model.SearchKeyword"
                            </span>
                        }
                        @if (Model.MaKhoaHoc.HasValue && ViewBag.KhoaHocs != null)
                        {
                            int selectedId = Model.MaKhoaHoc.Value;
                            var khSelected = ((IEnumerable<QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.KhoaHoc>)ViewBag.KhoaHocs).FirstOrDefault(k => k.MaKhoaHoc == selectedId);
                            <span class="badge bg-info-subtle text-dark border border-info-subtle px-3 py-2 rounded-pill">
                                Khóa học: @(khSelected?.TenKhoaHoc ?? selectedId.ToString())
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.NgoaiNgu))
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                Ngoại ngữ: @Model.NgoaiNgu
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.TrangThai))
                        {
                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-3 py-2 rounded-pill">
                                Trạng thái: @Model.TrangThai
                            </span>
                        }
                        @if (Model.GiaTu.HasValue || Model.GiaDen.HasValue)
                        {
                            string priceText = "";
                            if (Model.GiaTu.HasValue && Model.GiaDen.HasValue)
                            {
                                priceText = $"Học phí: {Model.GiaTu.Value:N0}đ - {Model.GiaDen.Value:N0}đ";
                            }
                            else if (Model.GiaTu.HasValue)
                            {
                                priceText = $"Học phí từ: {Model.GiaTu.Value:N0}đ";
                            }
                            else if (Model.GiaDen.HasValue)
                            {
                                priceText = $"Học phí đến: {Model.GiaDen.Value:N0}đ";
                            }
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-bold">
                                @priceText
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Model.SortOrder) && Model.SortOrder != "name_asc")
                        {
                            <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill">
                                Sắp xếp: @Model.SortOrder
                            </span>
                        }
                        <a asp-action="Index" class="btn btn-link btn-sm text-danger text-decoration-none ms-auto fw-semibold">
                            <i class="bi bi-x-circle me-1"></i>Xóa tất cả bộ lọc
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- BẢNG HIỂN THỊ DANH SÁCH LỚP HỌC -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-secondary">
                Tìm thấy <span class="text-primary fs-5">@Model.TotalItems</span> lớp học thỏa mãn điều kiện
            </span>
            <span class="badge bg-secondary">Trang @Model.CurrentPage / @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-primary text-nowrap">
                    <tr>
                        <th>Mã lớp</th>
                        <th>Tên lớp</th>
                        <th>Khóa học</th>
                        <th>Khai giảng</th>
                        <th>Lịch học</th>
                        <th>Phòng</th>
                        <th>Sĩ số tối đa</th>
                        <th>Học phí</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachLop != null && Model.DanhSachLop.Any())
                    {
                        @foreach (var item in Model.DanhSachLop)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@item.MaLop</td>
                                <td class="fw-bold text-primary">@item.TenLop</td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        @(item.KhoaHoc?.TenKhoaHoc ?? "Chưa xác định")
                                    </span>
                                </td>
                                <td>@item.NgayKhaiGiang.ToString("dd/MM/yyyy")</td>
                                <td><small class="text-muted">@item.LichHoc</small></td>
                                <td>@item.PhongHoc</td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@item.SoLuongToiDa học viên</span></td>
                                <td class="text-danger fw-bold">@item.HocPhi.ToString("N0") VNĐ</td>
                                <td>
                                    @switch (item.TrangThai)
                                    {
                                        case "Đang tuyển sinh":
                                            <span class="badge bg-success">Đang tuyển sinh</span>
                                            break;
                                        case "Sắp mở":
                                            <span class="badge bg-warning text-dark">Sắp mở</span>
                                            break;
                                        case "Đang học":
                                            <span class="badge bg-primary">Đang học</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">Đã kết thúc</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item.MaLop" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i> Chi tiết
                                    </a>

                                    @if (isAdmin)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.MaLop" class="btn btn-sm btn-outline-warning ms-1" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaLop" class="btn btn-sm btn-outline-danger ms-1" title="Xóa">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không tìm thấy lớp học nào phù hợp với điều kiện tìm kiếm và lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                        
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-CurrentPage="@(Model.CurrentPage - 1)"
                               asp-route-SearchKeyword="@Model.SearchKeyword"
                               asp-route-MaKhoaHoc="@Model.MaKhoaHoc"
                               asp-route-NgoaiNgu="@Model.NgoaiNgu"
                               asp-route-TrangThai="@Model.TrangThai"
                               asp-route-GiaTu="@(Model.GiaTu.HasValue ? Model.GiaTu.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "")"
                               asp-route-GiaDen="@(Model.GiaDen.HasValue ? Model.GiaDen.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "")"
                               asp-route-SortOrder="@Model.SortOrder">
                                &laquo; Trước
                            </a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-CurrentPage="@p"
                                   asp-route-SearchKeyword="@Model.SearchKeyword"
                                   asp-route-MaKhoaHoc="@Model.MaKhoaHoc"
                                   asp-route-NgoaiNgu="@Model.NgoaiNgu"
                                   asp-route-TrangThai="@Model.TrangThai"
                                   asp-route-GiaTu="@(Model.GiaTu.HasValue ? Model.GiaTu.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                   asp-route-GiaDen="@(Model.GiaDen.HasValue ? Model.GiaDen.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                   asp-route-SortOrder="@Model.SortOrder">
                                    @p
                                </a>
                            </li>
                        }

                        <!-- Nút Trang sau -->
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                               asp-route-SearchKeyword="@Model.SearchKeyword"
                               asp-route-MaKhoaHoc="@Model.MaKhoaHoc"
                               asp-route-NgoaiNgu="@Model.NgoaiNgu"
                               asp-route-TrangThai="@Model.TrangThai"
                               asp-route-GiaTu="@(Model.GiaTu.HasValue ? Model.GiaTu.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "")"
                               asp-route-GiaDen="@(Model.GiaDen.HasValue ? Model.GiaDen.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : "")"
                               asp-route-SortOrder="@Model.SortOrder">
                                Sau &raquo;
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
