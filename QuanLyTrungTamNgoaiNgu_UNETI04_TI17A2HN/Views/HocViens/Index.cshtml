@*
    Họ và tên: Diem Duc Hung
    Mã sinh viên: 23103100099
    Nội dung thực hiện: Module 3 - Danh sách học viên
*@
@model IEnumerable<QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.HocVien>

@{
    ViewData["Title"] = "Danh sách học viên";
}

<div class="container py-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h3 class="fw-bold">Quản lý học viên</h3>
        </div>
        <div class="col-md-4 text-end">
        </div>
    </div>

    @if (TempData["ThanhCong"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["ThanhCong"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-10">
                    <input type="text" name="tuKhoa" class="form-control" placeholder="Tìm kiếm theo tên, email, sđt..." value="@ViewBag.TuKhoa" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã HV</th>
                            <th>Họ Tên</th>
                            <th>Ngày Sinh</th>
                            <th>Giới Tính</th>
                            <th>SĐT</th>
                            <th>Email</th>
                            <th>Tài Khoản</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.MaHocVien</td>
                                    <td class="fw-bold">@item.HoTen</td>
                                    <td>@item.NgaySinh.ToString("dd/MM/yyyy")</td>
                                    <td>@item.GioiTinh</td>
                                    <td>@item.SoDienThoai</td>
                                    <td>@item.Email</td>
                                    <td>@(item.TaiKhoan?.TenDangNhap ?? "N/A")</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.MaHocVien" class="btn btn-sm btn-info text-white">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-danger py-4">Không có dữ liệu học viên</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
