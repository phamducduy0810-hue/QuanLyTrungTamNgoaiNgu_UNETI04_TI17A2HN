@*
    Họ và tên: Diem Duc Hung
    Mã sinh viên: 23103100099
    Nội dung thực hiện: Module 3 - Lịch sử đăng ký học
*@
@model IEnumerable<QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.DangKyHoc>

@{
    ViewData["Title"] = "Lịch sử đăng ký";
}

<div class="container py-4">
    <div class="row mb-3">
        <div class="col-md-12">
            <h3 class="fw-bold"><i class="bi bi-clock-history me-2"></i>Lịch sử đăng ký học của bạn</h3>
        </div>
    </div>

    @if (TempData["ThanhCong"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["ThanhCong"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã ĐK</th>
                            <th>Tên lớp</th>
                            <th>Tên khóa học</th>
                            <th>Ngày đăng ký</th>
                            <th>Học phí</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>#@item.MaDangKy</td>
                                    <td class="fw-bold text-primary">@(item.LopHoc?.TenLop)</td>
                                    <td>@(item.LopHoc?.KhoaHoc?.TenKhoaHoc)</td>
                                    <td>@item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-danger fw-bold">@item.HocPhi.ToString("N0") VNĐ</td>
                                    <td>
                                        @if (item.TrangThai == "Đã xác nhận")
                                        {
                                            <span class="badge bg-success">Đã xác nhận</span>
                                        }
                                        else if (item.TrangThai == "Chờ xác nhận")
                                        {
                                            <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Đã hủy</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="LopHocs" asp-action="Details" asp-route-id="@item.MaLop" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i> Lớp học
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Bạn chưa đăng ký lớp học nào. 
                                    <a asp-controller="LopHocs" asp-action="Index">Xem danh sách lớp học</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
