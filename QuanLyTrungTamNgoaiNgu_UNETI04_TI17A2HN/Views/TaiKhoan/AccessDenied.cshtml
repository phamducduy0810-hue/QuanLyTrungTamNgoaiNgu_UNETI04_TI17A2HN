@{
    ViewData["Title"] = "Từ Chối Truy Cập";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 text-center">
        <div class="card-custom p-5">
            <div class="text-danger mb-3">
                <i class="fa-solid fa-triangle-exclamation fa-5x"></i>
            </div>
            <h2 class="fw-extrabold text-danger mb-2">TỪ CHỐI TRUY CẬP!</h2>
            <p class="text-muted lead mb-4">Tài khoản của bạn không có đủ quyền hạn để truy cập vào trang này.</p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary fw-bold rounded-pill px-4">
                    <i class="fa-solid fa-house me-2"></i>Về Trang chủ
                </a>
                <a asp-action="Login" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Đăng nhập tài khoản khác
                </a>
            </div>
        </div>
    </div>
</div>
