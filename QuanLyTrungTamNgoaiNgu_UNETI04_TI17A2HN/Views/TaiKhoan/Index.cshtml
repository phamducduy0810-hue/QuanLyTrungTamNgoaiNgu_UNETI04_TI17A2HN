@*
    Họ và tên: Phạm Văn Công
    Mã sinh viên: 23103100115
    Nội dung thực hiện: Module 1 - Trang Quản lý tài khoản (Admin)
*@
@model IEnumerable<QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.TaiKhoan>

@{
    ViewData["Title"] = "Quản Lý Tài Khoản Hệ Thống";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-extrabold text-primary mb-1"><i class="fa-solid fa-users-gear me-2"></i>Quản Lý Tài Khoản Hệ Thống</h2>
        <p class="text-muted mb-0">Quản lý danh sách tài khoản người dùng, phân quyền Admin/Học viên</p>
    </div>
</div>

<div class="card-custom p-0 overflow-hidden shadow-sm">
    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Mã TK</th>
                    <th>Tên Đăng Nhập</th>
                    <th>Họ và Tên</th>
                    <th>Email</th>
                    <th>Vai Trò</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">#TK@item.MaTaiKhoan.ToString("D4")</td>
                            <td><strong class="text-dark">@item.TenDangNhap</strong></td>
                            <td>@item.HoTen</td>
                            <td>@item.Email</td>
                            <td>
                                @if (item.VaiTro == "Admin")
                                {
                                    <span class="badge bg-danger px-3 py-1 rounded-pill"><i class="fa-solid fa-shield-halved me-1"></i>ADMIN</span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-3 py-1 rounded-pill"><i class="fa-solid fa-user-graduate me-1"></i>HỌC VIÊN</span>
                                }
                            </td>
                            <td>
                                @if (item.TrangThai)
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-1"><i class="fa-solid fa-check me-1"></i>Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-2 py-1"><i class="fa-solid fa-lock me-1"></i>Bị khóa</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
