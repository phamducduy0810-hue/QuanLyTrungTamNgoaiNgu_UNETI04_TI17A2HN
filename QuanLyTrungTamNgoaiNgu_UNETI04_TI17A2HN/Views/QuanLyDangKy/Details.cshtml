@* Họ và tên: Lê Đăng Duy *@
@* Mã sinh viên: 23103100089 *@
@* Nội dung thực hiện: Module 4 - Giao diện chi tiết đăng ký và cập nhật trạng thái *@
@model QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.DangKyHoc
@using System.Globalization
@{
    ViewData["Title"] = $"Đăng ký #{Model.MaDangKy}";

    int soDaXacNhan = ViewBag.SoDaXacNhan;
    var dsTrangThai = (string[])ViewBag.DanhSachTrangThai;
    int toiDa = Model.LopHoc?.SoLuongToiDa ?? 0;
    int conCho = Math.Max(toiDa - soDaXacNhan, 0);
    bool lopDay = toiDa > 0 && soDaXacNhan >= toiDa;
    double phanTram = toiDa > 0 ? Math.Min(100.0, soDaXacNhan * 100.0 / toiDa) : 0;
    string phanTramCss = phanTram.ToString("0.#", CultureInfo.InvariantCulture);
    string mauThanh = lopDay ? "red" : (phanTram >= 80 ? "amber" : "green");
    string pill = Model.TrangThai == TrangThaiDangKy.DaXacNhan ? "xn"
                : Model.TrangThai == TrangThaiDangKy.DaHuy ? "huy" : "cho";
    // Không thể xác nhận thêm khi lớp đã đủ (trừ khi đăng ký này đã được xác nhận sẵn)
    bool khongTheXacNhan = lopDay && Model.TrangThai != TrangThaiDangKy.DaXacNhan;
}

<partial name="_Module4Styles" />

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Quản lý đăng ký</a></li>
        <li class="breadcrumb-item active" aria-current="page">Đăng ký #@Model.MaDangKy</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h2 class="m4-page-title mb-0">Đăng ký #@Model.MaDangKy</h2>
    <span class="m4-pill @pill">@Model.TrangThai</span>
</div>

@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["ThanhCong"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Loi"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="m4-card mb-4">
            <div class="m4-card-head">Học viên</div>
            <div class="m4-card-body">
                <dl class="m4-dl">
                    <dt>Họ và tên</dt><dd>@Model.HocVien?.HoTen</dd>
                    <dt>Email</dt><dd>@Model.HocVien?.Email</dd>
                    <dt>Số điện thoại</dt><dd>@Model.HocVien?.SoDienThoai</dd>
                </dl>
            </div>
        </div>

        <div class="m4-card">
            <div class="m4-card-head">Lớp học và đăng ký</div>
            <div class="m4-card-body">
                <dl class="m4-dl">
                    <dt>Lớp học</dt><dd>@Model.LopHoc?.TenLop</dd>
                    <dt>Khóa học</dt><dd>@Model.LopHoc?.KhoaHoc?.TenKhoaHoc</dd>
                    <dt>Ngày khai giảng</dt><dd>@(Model.LopHoc?.NgayKhaiGiang.ToString("dd/MM/yyyy"))</dd>
                    <dt>Ngày đăng ký</dt><dd>@Model.NgayDangKy.ToString("dd/MM/yyyy")</dd>
                    <dt>Học phí</dt><dd>@Model.HocPhi.ToString("N0") đ</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="m4-card mb-4">
            <div class="m4-card-head">Sĩ số lớp (đã xác nhận)</div>
            <div class="m4-card-body">
                <div class="d-flex justify-content-between align-items-baseline mb-2">
                    <span class="fs-3 fw-bold">@soDaXacNhan / @toiDa</span>
                    <span class="@(lopDay ? "text-danger fw-semibold" : "text-muted")">
                        @(lopDay ? "Lớp đã đủ" : $"Còn {conCho} chỗ")
                    </span>
                </div>
                <div class="m4-bar @mauThanh"><span style="width:@(phanTramCss)%"></span></div>
                @if (khongTheXacNhan)
                {
                    <p class="small text-danger mt-3 mb-0">Lớp đã đủ học viên, không thể xác nhận thêm đăng ký này.</p>
                }
            </div>
        </div>

        <div class="m4-card">
            <div class="m4-card-head">Cập nhật trạng thái</div>
            <div class="m4-card-body">
                <form asp-action="CapNhatTrangThai" method="post">
                    <input type="hidden" name="id" value="@Model.MaDangKy" />
                    <label for="trangThai" class="form-label">Trạng thái mới</label>
                    <select id="trangThai" name="trangThai" class="form-select mb-3">
                        @foreach (var tt in dsTrangThai)
                        {
                            <option value="@tt" selected="@(tt == Model.TrangThai)">@tt</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary w-100">Lưu trạng thái</button>
                </form>

                @if (Model.TrangThai != TrangThaiDangKy.DaHuy)
                {
                    <hr />
                    <div class="d-grid gap-2">
                        @if (Model.TrangThai == TrangThaiDangKy.ChoXacNhan)
                        {
                            <form asp-action="XacNhan" method="post">
                                <input type="hidden" name="id" value="@Model.MaDangKy" />
                                <input type="hidden" name="quayLai" value="Details" />
                                <button type="submit" class="btn btn-success w-100" disabled="@khongTheXacNhan">Xác nhận đăng ký</button>
                            </form>
                        }
                        <form asp-action="Huy" method="post"
                              onsubmit="return confirm('Bạn chắc chắn muốn hủy đăng ký này?');">
                            <input type="hidden" name="id" value="@Model.MaDangKy" />
                            <input type="hidden" name="quayLai" value="Details" />
                            <button type="submit" class="btn btn-outline-danger w-100">Hủy đăng ký</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary mt-4">Quay lại danh sách</a>