@*
    Họ và tên: Phạm Văn Công
    Mã sinh viên: 23103100115
    Nội dung thực hiện: Module 1 - Giao diện Danh sách Khóa học chuẩn quốc tế, tích hợp hình ảnh nền văn hóa đặc trưng
*@
@model IEnumerable<QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.KhoaHoc>

@{
    ViewData["Title"] = "Chương Trình Đào Tạo - Khóa Học Ngoại Ngữ";
    var session = Context.Session;
    var vaiTro = session.GetString("VaiTro");
    bool isAdmin = (vaiTro == "Admin");

    int totalCourses = Model?.Count() ?? 0;
}

<style>
    /* COURSE HERO BANNER */
    .course-hero-banner {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%);
        border-radius: 24px;
        padding: 3rem 2.5rem;
        color: #ffffff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 12px 36px rgba(30, 58, 138, 0.25);
        margin-bottom: 2rem;
    }

    .course-hero-banner::before {
        content: "";
        position: absolute;
        top: -50%;
        right: -10%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    /* COURSE CARD STYLING */
    .course-card-modern {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
    }

    .course-card-modern:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 35px rgba(30, 58, 138, 0.15);
        border-color: #cbd5e1;
    }

    /* CARD COVER IMAGE CONTAINER */
    .course-card-cover {
        height: 190px;
        position: relative;
        overflow: hidden;
        background-color: #0f172a;
    }

    .course-card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .course-card-modern:hover .course-card-img {
        transform: scale(1.08);
    }

    .course-card-img-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.5) 0%, rgba(15, 23, 42, 0.05) 45%, rgba(15, 23, 42, 0.8) 100%);
        z-index: 1;
        pointer-events: none;
    }

    .course-price-box {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 0.85rem 1rem;
    }

    .course-meta-pill {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.35rem 0.65rem;
        font-size: 0.78rem;
        color: #475569;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
    }

    /* QUICK FILTER PILLS */
    .filter-pill {
        border-radius: 30px;
        padding: 0.45rem 1.1rem;
        font-size: 0.85rem;
        font-weight: 600;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        border: 1px solid #cbd5e1;
        color: #475569;
        background: #ffffff;
    }

    .filter-pill:hover {
        background: #f1f5f9;
        color: #1e293b;
        border-color: #94a3b8;
    }

    .filter-pill.active {
        background: #1e3a8a;
        color: #ffffff;
        border-color: #1e3a8a;
        box-shadow: 0 4px 12px rgba(30, 58, 138, 0.25);
    }
</style>

<!-- HERO HEADER BANNER -->
<div class="course-hero-banner">
    <div class="row align-items-center position-relative z-1">
        <div class="col-lg-8">
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm">
                <i class="fa-solid fa-graduation-cap me-1"></i> TRUNG TÂM NGOẠI NGỮ UNETI
            </span>
            <h1 class="display-5 fw-extrabold text-white mb-2">Chương Trình Đào Tạo Ngoại Ngữ</h1>
            <p class="lead text-light opacity-90 mb-4">
                Hệ thống khóa học chuẩn khung tham chiếu Châu Âu (CEFR), HSK, JLPT & TOPIK với đội ngũ giảng viên giàu kinh nghiệm thực chiến.
            </p>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="badge bg-white bg-opacity-10 text-white px-3 py-2 rounded-pill border border-light border-opacity-25">
                    <i class="fa-solid fa-book-bookmark text-warning me-1"></i> @totalCourses Khóa học đang tuyển sinh
                </span>
                <span class="badge bg-white bg-opacity-10 text-white px-3 py-2 rounded-pill border border-light border-opacity-25">
                    <i class="fa-solid fa-award text-success me-1"></i> Cam kết chuẩn đầu ra
                </span>
                <span class="badge bg-white bg-opacity-10 text-white px-3 py-2 rounded-pill border border-light border-opacity-25">
                    <i class="fa-solid fa-clock-rotate-left text-info me-1"></i> Lịch học linh hoạt
                </span>
            </div>
        </div>
        <div class="col-lg-4 text-end mt-4 mt-lg-0">
            @if (isAdmin)
            {
                <a asp-action="Create" class="btn btn-warning btn-lg fw-bold text-dark rounded-pill px-4 shadow">
                    <i class="fa-solid fa-plus-circle me-2"></i>Thêm Khóa Học Mới
                </a>
            }
        </div>
    </div>
</div>

<!-- KHUNG LỌC & TÌM KIẾM HIỆN ĐẠI -->
<div class="card-custom p-4 mb-4 border-0 shadow-sm rounded-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-bold small text-secondary mb-1">
                <i class="fa-solid fa-earth-asia text-primary me-1"></i> Ngoại ngữ
            </label>
            <select name="searchNgoaiNgu" class="form-select bg-light border-0 py-2">
                <option value="">-- Tất cả ngoại ngữ --</option>
                <option value="Tiếng Anh" selected="@(ViewBag.SearchNgoaiNgu == "Tiếng Anh" ? "selected" : null)">Tiếng Anh</option>
                <option value="Tiếng Trung" selected="@(ViewBag.SearchNgoaiNgu == "Tiếng Trung" ? "selected" : null)">Tiếng Trung</option>
                <option value="Tiếng Nhật" selected="@(ViewBag.SearchNgoaiNgu == "Tiếng Nhật" ? "selected" : null)">Tiếng Nhật</option>
                <option value="Tiếng Hàn" selected="@(ViewBag.SearchNgoaiNgu == "Tiếng Hàn" ? "selected" : null)">Tiếng Hàn</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-bold small text-secondary mb-1">
                <i class="fa-solid fa-layer-group text-primary me-1"></i> Cấp độ đào tạo
            </label>
            <select name="searchCapDo" class="form-select bg-light border-0 py-2">
                <option value="">-- Tất cả cấp độ --</option>
                <option value="Sơ cấp" selected="@(ViewBag.SearchCapDo == "Sơ cấp" ? "selected" : null)">Sơ cấp (Căn bản)</option>
                <option value="Trung cấp" selected="@(ViewBag.SearchCapDo == "Trung cấp" ? "selected" : null)">Trung cấp (Giao tiếp/Thi)</option>
                <option value="Cao cấp" selected="@(ViewBag.SearchCapDo == "Cao cấp" ? "selected" : null)">Cao cấp (Chuyên sâu)</option>
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label fw-bold small text-secondary mb-1">
                <i class="fa-solid fa-magnifying-glass text-primary me-1"></i> Từ khóa tìm kiếm
            </label>
            <div class="input-group">
                <input type="text" name="searchKeyword" value="@ViewBag.SearchKeyword" class="form-control bg-light border-0 py-2" placeholder="Tên khóa học, chứng chỉ..." />
            </div>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary fw-bold w-100 py-2 rounded-3 shadow-sm">
                <i class="fa-solid fa-filter me-1"></i>Lọc
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary py-2 rounded-3 px-3" title="Đặt lại bộ lọc">
                <i class="fa-solid fa-rotate-left"></i>
            </a>
        </div>
    </form>

    <!-- QUICK LANGUAGE PILLS -->
    <div class="d-flex flex-wrap gap-2 pt-3 mt-3 border-top align-items-center">
        <span class="small text-muted fw-bold me-2"><i class="fa-solid fa-bolt text-warning me-1"></i>Khám phá nhanh:</span>
        <a asp-action="Index" class="filter-pill @(string.IsNullOrEmpty(ViewBag.SearchNgoaiNgu) ? "active" : "")">
            Tất cả
        </a>
        <a asp-action="Index" asp-route-searchNgoaiNgu="Tiếng Anh" class="filter-pill @(ViewBag.SearchNgoaiNgu == "Tiếng Anh" ? "active" : "")">
            <i class="fa-solid fa-earth-americas text-primary me-1"></i> Tiếng Anh
        </a>
        <a asp-action="Index" asp-route-searchNgoaiNgu="Tiếng Trung" class="filter-pill @(ViewBag.SearchNgoaiNgu == "Tiếng Trung" ? "active" : "")">
            <i class="fa-solid fa-language text-danger me-1"></i> Tiếng Trung
        </a>
        <a asp-action="Index" asp-route-searchNgoaiNgu="Tiếng Nhật" class="filter-pill @(ViewBag.SearchNgoaiNgu == "Tiếng Nhật" ? "active" : "")">
            <i class="fa-solid fa-sun text-danger me-1"></i> Tiếng Nhật
        </a>
        <a asp-action="Index" asp-route-searchNgoaiNgu="Tiếng Hàn" class="filter-pill @(ViewBag.SearchNgoaiNgu == "Tiếng Hàn" ? "active" : "")">
            <i class="fa-solid fa-globe text-success me-1"></i> Tiếng Hàn
        </a>
    </div>
</div>

<!-- LƯỚI KHÓA HỌC THIẾT KẾ HIỆN ĐẠI CÓ BACKGROUND ẢNH VĂN HÓA -->
<div class="row g-4 mb-5">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            // Xác định ảnh nền và badge tương ứng theo từng quốc gia
            string bgImage = "/images/courses/england.jpg";
            string langBadgeColor = "bg-primary text-white";
            string iconClass = "fa-solid fa-earth-americas";

            if (item.NgoaiNgu.Contains("Nhật"))
            {
                bgImage = "/images/courses/japan.jpg";
                langBadgeColor = "bg-danger text-white";
                iconClass = "fa-solid fa-sun";
            }
            else if (item.NgoaiNgu.Contains("Trung"))
            {
                bgImage = "/images/courses/china.jpg";
                langBadgeColor = "bg-danger text-white";
                iconClass = "fa-solid fa-language";
            }
            else if (item.NgoaiNgu.Contains("Hàn"))
            {
                bgImage = "/images/courses/korea.jpg";
                langBadgeColor = "bg-success text-white";
                iconClass = "fa-solid fa-globe";
            }
            else
            {
                bgImage = "/images/courses/england.jpg";
                langBadgeColor = "bg-primary text-white";
                iconClass = "fa-solid fa-earth-americas";
            }

            int soLop = item.LopHocs?.Count ?? 0;
            int soLopTuyenSinh = item.LopHocs?.Count(l => l.TrangThai == "Đang tuyển sinh") ?? 0;

            <div class="col-md-6 col-lg-4">
                <div class="course-card-modern h-100">
                    <!-- BACKGROUND ẢNH VĂN HÓA ĐẶC TRƯNG TỪNG QUỐC GIA -->
                    <div class="course-card-cover position-relative">
                        <img src="@bgImage" alt="@item.TenKhoaHoc" class="course-card-img" />
                        <div class="course-card-img-overlay"></div>
                        
                        <!-- BADGE FLOATING TRÊN ẢNH NỀN -->
                        <div class="position-absolute top-0 start-0 w-100 p-3 d-flex justify-content-between align-items-center" style="z-index: 2;">
                            <span class="badge @langBadgeColor px-3 py-2 rounded-pill fw-bold shadow">
                                <i class="@iconClass me-1"></i>@item.NgoaiNgu
                            </span>
                            <span class="badge bg-white text-dark shadow px-2 py-1 rounded-pill fw-bold small">
                                @item.CapDo
                            </span>
                        </div>

                        <!-- TRẠNG THÁI FLOATING DƯỚI GÓC ẢNH -->
                        <div class="position-absolute bottom-0 start-0 p-3" style="z-index: 2;">
                            @if (item.TrangThai)
                            {
                                <span class="badge bg-success bg-opacity-90 text-white shadow-sm rounded-pill px-2 py-1 small">
                                    <i class="fa-solid fa-circle-check me-1"></i>Đang mở tuyển sinh
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-white shadow-sm rounded-pill px-2 py-1 small">Tạm dừng</span>
                            }
                        </div>
                    </div>

                    <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                        <div>
                            <!-- TIÊU ĐỀ KHÓA HỌC -->
                            <h4 class="fw-bold mb-2 text-dark" style="line-height: 1.35;">@item.TenKhoaHoc</h4>
                            <p class="text-muted small mb-3" style="min-height: 40px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrWhiteSpace(item.MoTa) ? "Chương trình đào tạo ngoại ngữ tiêu chuẩn quốc tế giúp học viên nâng cao trình độ nhanh chóng." : item.MoTa)
                            </p>

                            <!-- THÔNG SỐ KHÓA HỌC -->
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <span class="course-meta-pill">
                                    <i class="fa-regular fa-clock text-primary me-1"></i> @(item.SoBuoi > 0 ? item.SoBuoi : 24) buổi học
                                </span>
                                <span class="course-meta-pill">
                                    <i class="fa-solid fa-chalkboard-user text-success me-1"></i> @soLop lớp mở (@soLopTuyenSinh đang tuyển)
                                </span>
                            </div>
                        </div>

                        <div>
                            <!-- KHUNG HỌC PHÍ NIÊM YẾT -->
                            <div class="course-price-box d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="small text-muted d-block" style="font-size: 0.75rem;">Học phí trọn khóa:</span>
                                    <strong class="text-danger fw-extrabold fs-4">@item.HocPhi.ToString("N0") <small class="fs-6 text-muted">đ</small></strong>
                                </div>
                                <span class="badge bg-danger-subtle text-danger fw-semibold px-2 py-1 rounded">Ưu đãi UNETI</span>
                            </div>

                            <!-- NÚT THAO TÁC -->
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <a asp-action="Details" asp-route-id="@item.MaKhoaHoc" class="btn btn-outline-primary rounded-pill px-3 py-1 fw-bold small">
                                    Chi tiết & Lớp học <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>

                                @if (isAdmin)
                                {
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.MaKhoaHoc" class="btn btn-sm btn-light border" title="Chỉnh sửa khóa học">
                                            <i class="fa-solid fa-pen text-warning"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaKhoaHoc" class="btn btn-sm btn-light border text-danger" title="Xóa khóa học">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="p-5 bg-white rounded-4 shadow-sm border border-dashed">
                <i class="fa-solid fa-book-open-reader fa-4x text-muted mb-3 d-block opacity-50"></i>
                <h4 class="fw-bold text-dark mb-2">Không tìm thấy khóa học nào phù hợp</h4>
                <p class="text-muted mb-4">Vui lòng thử tìm kiếm với từ khóa khác hoặc xóa bộ lọc để xem toàn bộ chương trình đào tạo.</p>
                <a asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold">
                    <i class="fa-solid fa-rotate-left me-1"></i> Xem tất cả khóa học
                </a>
            </div>
        </div>
    }
</div>
