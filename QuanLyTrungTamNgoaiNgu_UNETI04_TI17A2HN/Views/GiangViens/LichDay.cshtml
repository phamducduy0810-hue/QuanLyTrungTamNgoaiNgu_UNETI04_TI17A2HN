@*
    Họ và tên: Diêm Đức Hùng
    Mã sinh viên: 23103100099
    Nội dung thực hiện: Module 3 - Giao diện Lịch dạy & Lớp học phụ trách dành cho Giảng viên
*@
@model IEnumerable<QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.LopHoc>

@{
    ViewData["Title"] = "Lịch dạy của tôi";
    var gv = ViewBag.GiangVien as QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.GiangVien;
}

<div class="container py-4">
    <!-- BANNER CHÀO MỪNG GIẢNG VIÊN -->
    <div class="card shadow border-0 text-white mb-4 rounded-4 overflow-hidden" 
         style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 55%, #0284c7 100%); box-shadow: 0 8px 24px rgba(30, 58, 138, 0.25);">
        <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="badge px-3 py-1 mb-2 fw-bold text-uppercase shadow-sm" 
                      style="background: #f59e0b; color: #0f172a; font-size: 0.75rem; letter-spacing: 0.5px;">
                    <i class="fa-solid fa-graduation-cap me-1"></i> Cổng thông tin Giảng viên
                </span>
                <h3 class="fw-bold mb-1" style="text-shadow: 0 2px 4px rgba(0,0,0,0.2);">
                    <i class="fa-solid fa-chalkboard-user me-2 text-warning"></i>Xin chào, @(gv?.HoTen ?? "Giảng viên")! 
                </h3>
                <p class="mb-0 text-white-50">
                    Chuyên môn: <strong class="text-white">@(gv?.ChuyenMon ?? "Chung")</strong> | 
                    Trình độ: <strong class="text-white">@(gv?.TrinhDo ?? "Chưa cập nhật")</strong> | 
                    Email: <strong class="text-white">@(gv?.Email)</strong>
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="HoSoCaNhan" class="btn btn-light px-3 py-2 fw-bold shadow-sm rounded-pill text-primary">
                    <i class="fa-solid fa-user-gear me-1"></i> Hồ sơ cá nhân
                </a>
            </div>
        </div>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["ThanhCong"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThanhCong"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Loi"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- THẺ THỐNG KÊ LỚP DẠY -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-primary border-4 bg-light">
                <div class="card-body p-3">
                    <div class="text-muted small fw-bold text-uppercase">Tổng số lớp được phân công</div>
                    <div class="fs-4 fw-bold text-primary mt-1">@(Model?.Count() ?? 0) lớp học</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-success border-4 bg-light">
                <div class="card-body p-3">
                    <div class="text-muted small fw-bold text-uppercase">Lớp đang giảng dạy</div>
                    <div class="fs-4 fw-bold text-success mt-1">@(Model?.Count(l => l.TrangThai == "Đang học" || l.TrangThai == "Đang giảng dạy") ?? 0) lớp</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-info border-4 bg-light">
                <div class="card-body p-3">
                    <div class="text-muted small fw-bold text-uppercase">Lớp sắp khai giảng</div>
                    <div class="fs-4 fw-bold text-info mt-1">@(Model?.Count(l => l.TrangThai == "Sắp mở" || l.TrangThai == "Đang tuyển sinh" || l.TrangThai == "Sắp khai giảng") ?? 0) lớp</div>
                </div>
            </div>
        </div>
    </div>

    <!-- DANH SÁCH LỚP HỌC ĐANG PHỤ TRÁCH -->
    <div class="card shadow border-0 rounded-4 overflow-hidden mb-5" style="box-shadow: 0 8px 24px rgba(30, 58, 138, 0.15) !important;">
        <div class="card-header p-4 text-white border-0"
             style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 55%, #0284c7 100%);">
            <div>
                <span class="badge px-3 py-1 mb-2 fw-bold text-uppercase shadow-sm" 
                      style="background: #f59e0b; color: #0f172a; font-size: 0.75rem; letter-spacing: 0.5px;">
                    <i class="fa-solid fa-calendar-days me-1"></i> Lịch trình giảng dạy
                </span>
                <h4 class="fw-bold mb-1 text-white" style="text-shadow: 0 2px 4px rgba(0,0,0,0.2); letter-spacing: 0.5px;">
                    <i class="fa-solid fa-calendar-week me-2 text-warning"></i>LỊCH DẠY &amp; DANH SÁCH LỚP HỌC CỦA BẠN
                </h4>
                <p class="mb-0 text-white-50" style="font-size: 0.9rem;">
                    Danh sách các lớp học được phân công giảng dạy chính thức tại <strong class="text-white">Trung tâm Ngoại ngữ UNETI</strong>
                </p>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead style="background: #f1f5f9; color: #1e293b; font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.4px;">
                        <tr class="border-bottom">
                            <th class="text-center py-3" style="width: 70px;">Mã lớp</th>
                            <th class="py-3">Tên lớp học</th>
                            <th class="py-3">Khóa học</th>
                            <th class="py-3">Lịch học</th>
                            <th class="py-3">Phòng học</th>
                            <th class="py-3">Ngày khai giảng</th>
                            <th class="text-center py-3">Sĩ số</th>
                            <th class="text-center py-3">Trạng thái</th>
                            <th class="text-center py-3" style="width: 190px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                int siSo = item.DangKyHocs?.Count(d => d.TrangThai == "Đã xác nhận") ?? 0;
                                <tr>
                                    <td class="text-center fw-bold text-muted">#@item.MaLop</td>
                                    <td>
                                        <div class="fw-bold text-primary fs-6">@item.TenLop</div>
                                    </td>
                                    <td>
                                        <div>@item.KhoaHoc?.TenKhoaHoc</div>
                                        <small class="text-muted">@item.KhoaHoc?.NgoaiNgu - @item.KhoaHoc?.CapDo</small>
                                    </td>
                                    <td>
                                        <i class="bi bi-clock text-primary me-1"></i><strong>@item.LichHoc</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-geo-alt me-1 text-danger"></i>@item.PhongHoc
                                        </span>
                                    </td>
                                    <td>@item.NgayKhaiGiang.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <span class="badge bg-info text-dark fs-6 px-2 py-1">
                                            @siSo / @item.SoLuongToiDa
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">@item.TrangThai</span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="DanhSachHocVien" asp-route-id="@item.MaLop" class="btn btn-sm btn-primary shadow-sm">
                                            <i class="bi bi-people-fill me-1"></i> DS Học viên
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-5">
                                    <i class="bi bi-calendar-x fs-1 d-block mb-2 text-warning"></i>
                                    Bạn hiện chưa được phân công phụ trách lớp học nào. Vui lòng liên hệ Admin trung tâm!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
