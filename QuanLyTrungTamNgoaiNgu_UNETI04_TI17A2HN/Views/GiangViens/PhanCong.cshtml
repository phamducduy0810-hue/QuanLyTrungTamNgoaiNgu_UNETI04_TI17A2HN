@*
    Họ và tên: Diêm Đức Hùng
    Mã sinh viên: 23103100099
    Nội dung thực hiện: Module 3 - Giao diện Quản lý Phân công lớp học của giảng viên
*@
@model QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.PhanCongLopViewModel

@{
    ViewData["Title"] = "Quản lý Phân công lớp học";
    int tongSoLop = Model.DanhSachLop.Count;
    int lopDaPhanCong = Model.DanhSachLop.Count(l => l.MaGiangVien != null);
    int lopChuaPhanCong = Model.DanhSachLop.Count(l => l.MaGiangVien == null);
}

<div class="container py-4">
    <!-- TIÊU ĐỀ -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="text-primary fw-bold mb-1">
                <i class="bi bi-calendar2-check-fill me-2 text-warning"></i>QUẢN LÝ PHÂN CÔNG LỚP HỌC
            </h2>
            <p class="text-muted mb-0">
                <span class="badge bg-secondary me-2">Module 3</span>
                <strong>Diêm Đức Hùng - 23103100099</strong>: Phân công giảng viên phụ trách các lớp học
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-primary px-3 shadow-sm">
                <i class="bi bi-people-fill me-1"></i> Danh sách Giảng viên
            </a>
            <a asp-action="Create" class="btn btn-success px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Thêm Giảng viên
            </a>
        </div>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["ThanhCong"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThanhCong"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Loi"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- THẺ THỐNG KÊ PHÂN CÔNG -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-primary border-4 bg-light">
                <div class="card-body p-3">
                    <div class="text-muted small fw-bold text-uppercase">Tổng số lớp trong danh sách</div>
                    <div class="fs-4 fw-bold text-primary mt-1">@tongSoLop lớp</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-success border-4 bg-light">
                <div class="card-body p-3">
                    <div class="text-muted small fw-bold text-uppercase">Lớp đã có giảng viên phụ trách</div>
                    <div class="fs-4 fw-bold text-success mt-1">@lopDaPhanCong lớp</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 border-start border-warning border-4 bg-light">
                <div class="card-body p-3">
                    <div class="text-muted small fw-bold text-uppercase">Lớp đang chờ phân công</div>
                    <div class="fs-4 fw-bold text-warning mt-1">@lopChuaPhanCong lớp</div>
                </div>
            </div>
        </div>
    </div>

    <!-- NẾU ĐANG CHỌN XEM MỘT GIẢNG VIÊN CỤ THỂ -->
    @if (Model.GiangVienChon != null)
    {
        <div class="alert alert-info border-0 shadow-sm d-flex justify-content-between align-items-center mb-4">
            <div>
                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                Đang lọc phân công cho giảng viên: <strong>@Model.GiangVienChon.HoTen</strong> 
                (SĐT: @Model.GiangVienChon.SoDienThoai - Chuyên môn: @(Model.GiangVienChon.ChuyenMon ?? "Chung"))
            </div>
            <a asp-action="PhanCong" class="btn btn-sm btn-outline-dark">
                <i class="bi bi-x-circle me-1"></i> Xem tất cả lớp
            </a>
        </div>
    }

    <!-- FORM TÌM KIẾM & BỘ LỌC -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3">
            <form method="get" asp-action="PhanCong">
                <div class="row g-2 align-items-center">
                    <!-- Từ khóa -->
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control" placeholder="Tìm theo tên lớp, phòng..." />
                        </div>
                    </div>

                    <!-- Khóa học -->
                    <div class="col-md-3">
                        <select name="maKhoaHoc" class="form-select">
                            <option value="">-- Tất cả khóa học --</option>
                            @foreach (var kh in Model.DanhSachKhoaHoc)
                            {
                                <option value="@kh.MaKhoaHoc" selected="@(Model.MaKhoaHoc == kh.MaKhoaHoc ? "selected" : null)">
                                    @kh.TenKhoaHoc
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Giảng viên -->
                    <div class="col-md-3">
                        <select name="maGiangVien" class="form-select">
                            <option value="">-- Tất cả giảng viên --</option>
                            @foreach (var gv in Model.DanhSachGiangVien)
                            {
                                <option value="@gv.MaGiangVien" selected="@(Model.MaGiangVien == gv.MaGiangVien ? "selected" : null)">
                                    @gv.HoTen (@(string.IsNullOrEmpty(gv.ChuyenMon) ? "Chung" : gv.ChuyenMon))
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Trạng thái phân công -->
                    <div class="col-md-2">
                        <select name="trangThaiPhanCong" class="form-select">
                            <option value="">-- Trạng thái PC --</option>
                            <option value="DaPhanCong" selected="@(Model.TrangThaiPhanCong == "DaPhanCong" ? "selected" : null)">Đã phân công</option>
                            <option value="ChuaPhanCong" selected="@(Model.TrangThaiPhanCong == "ChuaPhanCong" ? "selected" : null)">Chưa phân công</option>
                        </select>
                    </div>

                    <!-- Nút lọc & reset -->
                    <div class="col-md-1 d-flex gap-1">
                        <button type="submit" class="btn btn-primary w-100" title="Áp dụng bộ lọc">
                            <i class="bi bi-funnel"></i>
                        </button>
                        <a asp-action="PhanCong" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- BẢNG PHÂN CÔNG LỚP HỌC -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-list-check me-2"></i>DANH SÁCH LỚP HỌC & GIẢNG VIÊN PHỤ TRÁCH
            </h5>
            <small class="text-light">Thay đổi giảng viên trực tiếp tại mỗi dòng và nhấn Lưu</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-secondary">
                        <tr>
                            <th class="text-center" style="width: 70px;">Mã lớp</th>
                            <th style="min-width: 180px;">Tên lớp học</th>
                            <th>Khóa học</th>
                            <th>Lịch & Phòng</th>
                            <th class="text-center">Khai giảng</th>
                            <th>Giảng viên hiện tại</th>
                            <th style="min-width: 320px;">Phân công / Thay đổi giảng viên</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSachLop != null && Model.DanhSachLop.Any())
                        {
                            foreach (var lop in Model.DanhSachLop)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-muted">#@lop.MaLop</td>
                                    <td>
                                        <a asp-controller="LopHocs" asp-action="Details" asp-route-id="@lop.MaLop" class="fw-bold text-primary text-decoration-none" title="Xem chi tiết lớp học">
                                            @lop.TenLop
                                        </a>
                                        <div class="small text-muted">Trạng thái: @lop.TrangThai</div>
                                    </td>
                                    <td>
                                        <div>@lop.KhoaHoc?.TenKhoaHoc</div>
                                        <small class="text-muted">@lop.KhoaHoc?.NgoaiNgu - @lop.KhoaHoc?.CapDo</small>
                                    </td>
                                    <td>
                                        <div><i class="bi bi-clock me-1 text-muted"></i>@lop.LichHoc</div>
                                        <div><i class="bi bi-geo-alt me-1 text-muted"></i>Phòng: <strong>@lop.PhongHoc</strong></div>
                                    </td>
                                    <td class="text-center">@lop.NgayKhaiGiang.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (lop.GiangVien != null)
                                        {
                                            <a asp-action="Details" asp-route-id="@lop.GiangVien.MaGiangVien" class="badge bg-success text-decoration-none px-2 py-1 fs-6 d-inline-block" title="Xem hồ sơ giảng viên">
                                                <i class="bi bi-person-check-fill me-1"></i>@lop.GiangVien.HoTen
                                            </a>
                                            <div class="small text-muted mt-1"><i class="bi bi-telephone me-1"></i>@lop.GiangVien.SoDienThoai</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-2 py-1 fs-6">
                                                <i class="bi bi-exclamation-circle me-1"></i>Chưa phân công
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <!-- FORM PHÂN CÔNG / THAY ĐỔI NHANH -->
                                        <form asp-action="CapNhatPhanCong" method="post" class="d-flex gap-2 align-items-center">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="maLop" value="@lop.MaLop" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                                            <select name="maGiangVien" class="form-select form-select-sm">
                                                <option value="">-- Chưa có giảng viên --</option>
                                                @foreach (var gv in Model.DanhSachGiangVien)
                                                {
                                                    <option value="@gv.MaGiangVien" selected="@(lop.MaGiangVien == gv.MaGiangVien ? "selected" : null)">
                                                        @gv.HoTen (@(string.IsNullOrEmpty(gv.ChuyenMon) ? "Chung" : gv.ChuyenMon))
                                                    </option>
                                                }
                                            </select>

                                            <button type="submit" class="btn btn-sm btn-primary text-nowrap" title="Lưu phân công">
                                                <i class="bi bi-save me-1"></i> Lưu
                                            </button>

                                            @if (lop.MaGiangVien != null)
                                            {
                                                <button type="submit" name="maGiangVien" value="" class="btn btn-sm btn-outline-danger text-nowrap" title="Gỡ giảng viên khỏi lớp" onclick="return confirm('Bạn có chắc muốn hủy phân công giảng viên cho lớp @lop.TenLop?');">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    Không tìm thấy lớp học nào phù hợp với điều kiện tìm kiếm.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
