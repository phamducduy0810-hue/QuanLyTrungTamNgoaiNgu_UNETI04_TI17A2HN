@*
    Họ và tên: Diêm Đức Hùng
    Mã sinh viên: 23103100099
    Nội dung thực hiện: Module 3 - Cập nhật hồ sơ cá nhân Giảng viên
*@
@model QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.GiangVien

@{
    ViewData["Title"] = "Hồ sơ cá nhân Giảng viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0"> 
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-person-circle me-2"></i>HỒ SƠ CÁ NHÂN GIẢNG VIÊN
                    </h4>
                    <small>Cập nhật thông tin liên hệ và lý lịch chuyên môn | Module 3 - Diêm Đức Hùng</small>
                </div>
                <div class="card-body p-4">
                    @if (TempData["ThanhCong"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThanhCong"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="HoSoCaNhan" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaGiangVien" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="HoTen" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="HoTen" class="form-control" />
                                <span asp-validation-for="HoTen" class="text-danger"></span>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="GioiTinh" class="form-label fw-bold"></label>
                                <select asp-for="GioiTinh" class="form-select">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="NgaySinh" class="form-label fw-bold"></label>
                                <input asp-for="NgaySinh" type="date" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SoDienThoai" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="SoDienThoai" class="form-control" />
                                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TrinhDo" class="form-label fw-bold"></label>
                                <input asp-for="TrinhDo" class="form-control" placeholder="Học vị, chứng chỉ quốc tế..." />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ChuyenMon" class="form-label fw-bold"></label>
                                <input asp-for="ChuyenMon" class="form-control" placeholder="Chuyên môn giảng dạy..." />
                            </div>

                            <div class="col-12">
                                <label asp-for="DiaChi" class="form-label fw-bold"></label>
                                <input asp-for="DiaChi" class="form-control" />
                            </div>

                            <div class="col-12">
                                <label asp-for="GhiChu" class="form-label fw-bold"></label>
                                <textarea asp-for="GhiChu" class="form-control" rows="3" placeholder="Kinh nghiệm, thành tích, lịch rảnh..."></textarea>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="LichDay" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại lịch dạy
                            </a>
                            <button type="submit" class="btn btn-primary px-5 fw-bold">
                                <i class="bi bi-save me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
