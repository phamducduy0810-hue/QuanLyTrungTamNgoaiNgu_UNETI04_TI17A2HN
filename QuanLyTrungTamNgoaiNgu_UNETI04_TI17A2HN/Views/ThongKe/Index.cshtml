@* Họ và tên: Lê Đăng Duy *@
@* Mã sinh viên: 23103100089 *@
@* Nội dung thực hiện: Module 4 - Giao diện thống kê *@
@model QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.ViewModels.ThongKeViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Thống kê";

    string Pct(decimal v, decimal max) => max > 0
        ? ((double)v * 100.0 / (double)max).ToString("0.#", CultureInfo.InvariantCulture)
        : "0";

    int maxLop = Model.SoLopTheoKhoaHoc.Any() ? Model.SoLopTheoKhoaHoc.Max(x => x.SoLuong) : 0;
    int maxTrangThai = Model.DangKyTheoTrangThai.Any() ? Model.DangKyTheoTrangThai.Max(x => x.SoLuong) : 0;
    int maxDangKy = Model.DangKyTheoLop.Any() ? Model.DangKyTheoLop.Max(x => x.TongDangKy) : 0;
    decimal maxHpLop = Model.HocPhiTheoLop.Any() ? Model.HocPhiTheoLop.Max(x => x.TongHocPhi) : 0;
    decimal maxHpKhoa = Model.HocPhiTheoKhoaHoc.Any() ? Model.HocPhiTheoKhoaHoc.Max(x => x.TongHocPhi) : 0;
    decimal tongHocPhi = Model.HocPhiTheoKhoaHoc.Sum(x => x.TongHocPhi);
}

<partial name="_Module4Styles" />

<div class="d-flex flex-wrap justify-content-between align-items-center mb-1">
    <h2 class="m4-page-title mb-0">Thống kê</h2>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">Về Dashboard</a>
</div>
<p class="m4-page-sub">Số liệu về lớp học, đăng ký và học phí. Học phí chỉ tính các đăng ký đã xác nhận.</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="m4-stat green">
            <div class="label">Tổng học phí đã xác nhận</div>
            <div class="value">@tongHocPhi.ToString("N0") đ</div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="m4-stat blue">
            <div class="label">Lớp có nhiều đăng ký nhất</div>
            @if (Model.LopNhieuDangKyNhat.Any())
            {
                <div class="fs-5 fw-bold mt-1">@string.Join(", ", Model.LopNhieuDangKyNhat.Select(x => x.TenLop))</div>
                <div class="m4-sub">@Model.LopNhieuDangKyNhat.First().TongDangKy lượt đăng ký, trong đó @Model.LopNhieuDangKyNhat.First().DaXacNhan đã xác nhận</div>
            }
            else
            {
                <div class="text-muted mt-1">Chưa có đăng ký nào.</div>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="m4-card h-100">
            <div class="m4-card-head">Số lớp theo từng khóa học</div>
            <div class="table-responsive">
                <table class="table m4-table mb-0">
                    <thead><tr><th>Khóa học</th><th style="width:35%"></th><th class="num">Số lớp</th></tr></thead>
                    <tbody>
                        @foreach (var x in Model.SoLopTheoKhoaHoc)
                        {
                            <tr>
                                <td>@x.Ten</td>
                                <td><div class="m4-bar"><span style="width:@(Pct(x.SoLuong, maxLop))%"></span></div></td>
                                <td class="num fw-semibold">@x.SoLuong</td>
                            </tr>
                        }
                        @if (!Model.SoLopTheoKhoaHoc.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">Chưa có khóa học.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="m4-card h-100">
            <div class="m4-card-head">Số đăng ký theo từng trạng thái</div>
            <div class="table-responsive">
                <table class="table m4-table mb-0">
                    <thead><tr><th>Trạng thái</th><th style="width:35%"></th><th class="num">Số đăng ký</th></tr></thead>
                    <tbody>
                        @foreach (var x in Model.DangKyTheoTrangThai)
                        {
                            string mau = x.Ten == TrangThaiDangKy.DaXacNhan ? "green" : (x.Ten == TrangThaiDangKy.DaHuy ? "" : "amber");
                            string pill = x.Ten == TrangThaiDangKy.DaXacNhan ? "xn" : (x.Ten == TrangThaiDangKy.DaHuy ? "huy" : "cho");
                            <tr>
                                <td><span class="m4-pill @pill">@x.Ten</span></td>
                                <td><div class="m4-bar @mau"><span style="width:@(Pct(x.SoLuong, maxTrangThai))%"></span></div></td>
                                <td class="num fw-semibold">@x.SoLuong</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="m4-card">
            <div class="m4-card-head">Số học viên đăng ký theo từng lớp</div>
            <div class="table-responsive">
                <table class="table m4-table mb-0">
                    <thead>
                        <tr><th>Lớp</th><th style="width:30%"></th><th class="num">Tổng đăng ký</th><th class="num">Đã xác nhận</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var x in Model.DangKyTheoLop)
                        {
                            bool nhieuNhat = Model.LopNhieuDangKyNhat.Any(l => l.TenLop == x.TenLop);
                            <tr>
                                <td>
                                    @x.TenLop
                                    @if (nhieuNhat)
                                    {
                                        <span class="badge text-bg-primary ms-1">Nhiều nhất</span>
                                    }
                                </td>
                                <td><div class="m4-bar"><span style="width:@(Pct(x.TongDangKy, maxDangKy))%"></span></div></td>
                                <td class="num fw-semibold">@x.TongDangKy</td>
                                <td class="num">@x.DaXacNhan</td>
                            </tr>
                        }
                        @if (!Model.DangKyTheoLop.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">Chưa có lớp học.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="m4-card h-100">
            <div class="m4-card-head">Tổng học phí theo lớp</div>
            <div class="table-responsive">
                <table class="table m4-table mb-0">
                    <thead><tr><th>Lớp</th><th style="width:30%"></th><th class="num">Tổng học phí</th></tr></thead>
                    <tbody>
                        @foreach (var x in Model.HocPhiTheoLop)
                        {
                            <tr>
                                <td>@x.Ten</td>
                                <td><div class="m4-bar green"><span style="width:@(Pct(x.TongHocPhi, maxHpLop))%"></span></div></td>
                                <td class="num fw-semibold">@x.TongHocPhi.ToString("N0") đ</td>
                            </tr>
                        }
                        @if (!Model.HocPhiTheoLop.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">Chưa có đăng ký nào được xác nhận.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="m4-card h-100">
            <div class="m4-card-head">Tổng học phí theo khóa học</div>
            <div class="table-responsive">
                <table class="table m4-table mb-0">
                    <thead><tr><th>Khóa học</th><th style="width:30%"></th><th class="num">Tổng học phí</th></tr></thead>
                    <tbody>
                        @foreach (var x in Model.HocPhiTheoKhoaHoc)
                        {
                            <tr>
                                <td>@x.Ten</td>
                                <td><div class="m4-bar green"><span style="width:@(Pct(x.TongHocPhi, maxHpKhoa))%"></span></div></td>
                                <td class="num fw-semibold">@x.TongHocPhi.ToString("N0") đ</td>
                            </tr>
                        }
                        @if (!Model.HocPhiTheoKhoaHoc.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">Chưa có đăng ký nào được xác nhận.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>