@* Mã sinh viên: 23103100089 *@
@* Nội dung thực hiện: Module 4 - Giao diện thống kê *@
@model QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.ThongKeViewModel
@{
    ViewData["Title"] = "Thống kê";
}

<h2 class="mb-4">Thống kê</h2>

<div class="row g-4">

    <div class="col-md-6">
        <h5>1. Số lớp theo từng khóa học</h5>
        <table class="table table-bordered table-sm">
            <thead class="table-light"><tr><th>Khóa học</th><th class="text-end">Số lớp</th></tr></thead>
            <tbody>
                @foreach (var x in Model.SoLopTheoKhoaHoc)
                {
                    <tr><td>@x.Ten</td><td class="text-end">@x.SoLuong</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-6">
        <h5>2. Số đăng ký theo từng trạng thái</h5>
        <table class="table table-bordered table-sm">
            <thead class="table-light"><tr><th>Trạng thái</th><th class="text-end">Số đăng ký</th></tr></thead>
            <tbody>
                @foreach (var x in Model.DangKyTheoTrangThai)
                {
                    <tr><td>@x.Ten</td><td class="text-end">@x.SoLuong</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-12">
        <h5>3. Số học viên đăng ký theo từng lớp</h5>
        <table class="table table-bordered table-sm">
            <thead class="table-light">
                <tr><th>Lớp</th><th class="text-end">Tổng đăng ký</th><th class="text-end">Đã xác nhận</th></tr>
            </thead>
            <tbody>
                @foreach (var x in Model.DangKyTheoLop)
                {
                    <tr><td>@x.TenLop</td><td class="text-end">@x.TongDangKy</td><td class="text-end">@x.DaXacNhan</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-12">
        <h5>4. Lớp có nhiều học viên đăng ký nhất</h5>
        @if (Model.LopNhieuDangKyNhat.Any())
        {
            <ul class="list-group">
                @foreach (var x in Model.LopNhieuDangKyNhat)
                {
                    <li class="list-group-item">
                        <strong>@x.TenLop</strong> - @x.TongDangKy lượt đăng ký (@x.DaXacNhan đã xác nhận)
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Chưa có đăng ký nào.</p>
        }
    </div>

    <div class="col-md-6">
        <h5>5. Tổng học phí theo lớp <small class="text-muted">(chỉ đăng ký đã xác nhận)</small></h5>
        <table class="table table-bordered table-sm">
            <thead class="table-light"><tr><th>Lớp</th><th class="text-end">Tổng học phí</th></tr></thead>
            <tbody>
                @foreach (var x in Model.HocPhiTheoLop)
                {
                    <tr><td>@x.Ten</td><td class="text-end">@x.TongHocPhi.ToString("N0") đ</td></tr>
                }
                @if (!Model.HocPhiTheoLop.Any())
                {
                    <tr><td colspan="2" class="text-center text-muted">Chưa có dữ liệu.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-6">
        <h5>6. Tổng học phí theo khóa học <small class="text-muted">(chỉ đăng ký đã xác nhận)</small></h5>
        <table class="table table-bordered table-sm">
            <thead class="table-light"><tr><th>Khóa học</th><th class="text-end">Tổng học phí</th></tr></thead>
            <tbody>
                @foreach (var x in Model.HocPhiTheoKhoaHoc)
                {
                    <tr><td>@x.Ten</td><td class="text-end">@x.TongHocPhi.ToString("N0") đ</td></tr>
                }
                @if (!Model.HocPhiTheoKhoaHoc.Any())
                {
                    <tr><td colspan="2" class="text-center text-muted">Chưa có dữ liệu.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>