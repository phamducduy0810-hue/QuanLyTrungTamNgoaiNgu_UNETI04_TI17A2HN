@* Họ và tên: Lê Đăng Duy *@
@* Mã sinh viên: 23103100089 *@
@* Nội dung thực hiện: Module 4 - Giao diện thống kê & Bổ sung Xuất / Nhập Excel *@
@model QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.ViewModels.ThongKeViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Thống kê báo cáo";

    string Pct(decimal v, decimal max) => max > 0
        ? ((double)v * 100.0 / (double)max).ToString("0.#", CultureInfo.InvariantCulture)
        : "0";

    int maxLop = Model.SoLopTheoKhoaHoc.Any() ? Model.SoLopTheoKhoaHoc.Max(x => x.SoLuong) : 0;
    int maxTrangThai = Model.DangKyTheoTrangThai.Any() ? Model.DangKyTheoTrangThai.Max(x => x.SoLuong) : 0;
    int maxDangKy = Model.DangKyTheoLop.Any() ? Model.DangKyTheoLop.Max(x => x.TongDangKy) : 0;
    decimal maxHpLop = Model.HocPhiTheoLop.Any() ? Model.HocPhiTheoLop.Max(x => x.TongHocPhi) : 0;
    decimal maxHpKhoa = Model.HocPhiTheoKhoaHoc.Any() ? Model.HocPhiTheoKhoaHoc.Max(x => x.TongHocPhi) : 0;
    decimal tongHocPhi = Model.HocPhiTheoKhoaHoc.Sum(x => x.TongHocPhi);
}

<partial name="_Module4Styles" />

<!-- Thanh tiêu đề và nút chức năng Xuất / Nhập Excel -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
    <div>
        <h2 class="m4-page-title mb-0">Thống kê & Báo cáo</h2>
        <p class="m4-page-sub mb-0">Số liệu về lớp học, đăng ký và học phí. Học phí chỉ tính các đăng ký đã xác nhận.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportExcel" class="btn btn-success d-inline-flex align-items-center gap-2 shadow-sm px-3">
            <i class="fa-solid fa-file-excel"></i>
            <span>Xuất Excel Báo cáo</span>
        </a>
        <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#modalImportExcel">
            <i class="fa-solid fa-file-import"></i>
            <span>Nhập Excel</span>
        </button>
        <a asp-action="DownloadTemplate" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-download"></i>
            <span>File Mẫu</span>
        </a>
        <a asp-action="Dashboard" class="btn btn-outline-dark d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Về Dashboard</span>
        </a>
    </div>
</div>

<!-- Thông báo TempData -->
@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["ThanhCong"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["Loi"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<!-- Chi tiết kết quả nhập Excel (nếu vừa nhập) -->
@if (Model.KetQuaImport != null)
{
    <div class="card border-0 shadow-sm mb-4" style="background-color: #f8fafc; border-left: 5px solid #2563eb !important;">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h5 class="card-title mb-0 text-primary fw-bold">
                    <i class="fa-solid fa-file-waveform me-2"></i> Kết Quả Nhập Dữ Liệu Excel
                </h5>
                <span class="badge bg-secondary">Tổng số dòng xử lý: @Model.KetQuaImport.TongSoDong</span>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <div class="p-2 rounded bg-success-subtle text-success border border-success-subtle d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-check-circle me-1"></i> Thành công:</span>
                        <strong class="fs-5">@Model.KetQuaImport.SoThanhCong dòng</strong>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-2 rounded bg-danger-subtle text-danger border border-danger-subtle d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-triangle-exclamation me-1"></i> Dòng lỗi:</span>
                        <strong class="fs-5">@Model.KetQuaImport.SoLoi dòng</strong>
                    </div>
                </div>
            </div>

            @if (Model.KetQuaImport.DanhSachLoi.Any())
            {
                <div class="alert alert-warning mb-2 py-2">
                    <div class="fw-semibold mb-1 text-danger"><i class="fa-solid fa-list-ul me-1"></i> Danh sách dòng gặp lỗi:</div>
                    <ul class="mb-0 ps-3 small">
                        @foreach (var err in Model.KetQuaImport.DanhSachLoi)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }

            @if (Model.KetQuaImport.ChiTietThanhCong.Any())
            {
                <details class="small text-muted mt-2">
                    <summary class="cursor-pointer text-success fw-semibold">Xem chi tiết các bản ghi đã nhập/cập nhật (@Model.KetQuaImport.ChiTietThanhCong.Count)</summary>
                    <ul class="mb-0 ps-3 mt-1">
                        @foreach (var ok in Model.KetQuaImport.ChiTietThanhCong)
                        {
                            <li>@ok</li>
                        }
                    </ul>
                </details>
            }
        </div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="m4-stat green">
            <div class="label">Tổng học phí đã xác nhận</div>
            <div class="value">@tongHocPhi.ToString("N0") đ</div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="m4-stat blue">
            <div class="label">Lớp có nhiều đăng ký nhất</div>
            @if (Model.LopNhieuDangKyNhat.Any())
            {
                <div class="fs-5 fw-bold mt-1">@string.Join(", ", Model.LopNhieuDangKyNhat.Select(x => x.TenLop))</div>
                <div class="m4-sub">@Model.LopNhieuDangKyNhat.First().TongDangKy lượt đăng ký, trong đó @Model.LopNhieuDangKyNhat.First().DaXacNhan đã xác nhận</div>
            }
            else
            {
                <div class="text-muted mt-1">Chưa có đăng ký nào.</div>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="m4-card h-100">
            <div class="m4-card-head">Số lớp theo từng khóa học</div>
            <div class="table-responsive">
                <table class="table m4-table mb-0">
                    <thead><tr><th>Khóa học</th><th style="width:35%"></th><th class="num">Số lớp</th></tr></thead>
                    <tbody>
                        @foreach (var x in Model.SoLopTheoKhoaHoc)
                        {
                            <tr>
                                <td>@x.Ten</td>
                                <td><div class="m4-bar"><span style="width:@(Pct(x.SoLuong, maxLop))%"></span></div></td>
                                <td class="num fw-semibold">@x.SoLuong</td>
                            </tr>
                        }
                        @if (!Model.SoLopTheoKhoaHoc.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">Chưa có khóa học.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="m4-card h-100">
            <div class="m4-card-head">Số đăng ký theo từng trạng thái</div>
            <div class="table-responsive">
                <table class="table m4-table mb-0">
                    <thead><tr><th>Trạng thái</th><th style="width:35%"></th><th class="num">Số đăng ký</th></tr></thead>
                    <tbody>
                        @foreach (var x in Model.DangKyTheoTrangThai)
                        {
                            string mau = x.Ten == TrangThaiDangKy.DaXacNhan ? "green" : (x.Ten == TrangThaiDangKy.DaHuy ? "" : "amber");
                            string pill = x.Ten == TrangThaiDangKy.DaXacNhan ? "xn" : (x.Ten == TrangThaiDangKy.DaHuy ? "huy" : "cho");
                            <tr>
                                <td><span class="m4-pill @pill">@x.Ten</span></td>
                                <td><div class="m4-bar @mau"><span style="width:@(Pct(x.SoLuong, maxTrangThai))%"></span></div></td>
                                <td class="num fw-semibold">@x.SoLuong</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="m4-card">
            <div class="m4-card-head">Số học viên đăng ký theo từng lớp</div>
            <div class="table-responsive">
                <table class="table m4-table mb-0">
                    <thead>
                        <tr><th>Lớp</th><th style="width:30%"></th><th class="num">Tổng đăng ký</th><th class="num">Đã xác nhận</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var x in Model.DangKyTheoLop)
                        {
                            bool nhieuNhat = Model.LopNhieuDangKyNhat.Any(l => l.TenLop == x.TenLop);
                            <tr>
                                <td>
                                    @x.TenLop
                                    @if (nhieuNhat)
                                    {
                                        <span class="badge text-bg-primary ms-1">Nhiều nhất</span>
                                    }
                                </td>
                                <td><div class="m4-bar"><span style="width:@(Pct(x.TongDangKy, maxDangKy))%"></span></div></td>
                                <td class="num fw-semibold">@x.TongDangKy</td>
                                <td class="num">@x.DaXacNhan</td>
                            </tr>
                        }
                        @if (!Model.DangKyTheoLop.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">Chưa có lớp học.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="m4-card h-100">
            <div class="m4-card-head">Tổng học phí theo lớp</div>
            <div class="table-responsive">
                <table class="table m4-table mb-0">
                    <thead><tr><th>Lớp</th><th style="width:30%"></th><th class="num">Tổng học phí</th></tr></thead>
                    <tbody>
                        @foreach (var x in Model.HocPhiTheoLop)
                        {
                            <tr>
                                <td>@x.Ten</td>
                                <td><div class="m4-bar green"><span style="width:@(Pct(x.TongHocPhi, maxHpLop))%"></span></div></td>
                                <td class="num fw-semibold">@x.TongHocPhi.ToString("N0") đ</td>
                            </tr>
                        }
                        @if (!Model.HocPhiTheoLop.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">Chưa có đăng ký nào được xác nhận.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="m4-card h-100">
            <div class="m4-card-head">Tổng học phí theo khóa học</div>
            <div class="table-responsive">
                <table class="table m4-table mb-0">
                    <thead><tr><th>Khóa học</th><th style="width:30%"></th><th class="num">Tổng học phí</th></tr></thead>
                    <tbody>
                        @foreach (var x in Model.HocPhiTheoKhoaHoc)
                        {
                            <tr>
                                <td>@x.Ten</td>
                                <td><div class="m4-bar green"><span style="width:@(Pct(x.TongHocPhi, maxHpKhoa))%"></span></div></td>
                                <td class="num fw-semibold">@x.TongHocPhi.ToString("N0") đ</td>
                            </tr>
                        }
                        @if (!Model.HocPhiTheoKhoaHoc.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">Chưa có đăng ký nào được xác nhận.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nhập Excel -->
<div class="modal fade" id="modalImportExcel" tabindex="-1" aria-labelledby="modalImportExcelLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalImportExcelLabel">
                    <i class="fa-solid fa-file-excel me-2"></i> Nhập Dữ Liệu Excel Thống Kê
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Tải lên file Excel (.xlsx hoặc .xls) chứa danh sách đăng ký học viên. Hệ thống sẽ tự động cập nhật số liệu học viên, lớp học và doanh thu thống kê.
                    </p>

                    <div class="alert alert-info py-2 small d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <i class="fa-solid fa-circle-info me-1"></i>
                            <span>Chưa có file mẫu chuẩn?</span>
                        </div>
                        <a asp-action="DownloadTemplate" class="btn btn-sm btn-outline-primary bg-white">
                            <i class="fa-solid fa-download me-1"></i> Tải File Mẫu (.xlsx)
                        </a>
                    </div>

                    <div class="mb-3">
                        <label for="fileExcel" class="form-label fw-semibold">Chọn file Excel (.xlsx, .xls) <span class="text-danger">*</span></label>
                        <input class="form-control" type="file" id="fileExcel" name="fileExcel" accept=".xlsx, .xls" required>
                    </div>

                    <div class="bg-light p-3 rounded small text-secondary">
                        <div class="fw-semibold text-dark mb-1"><i class="fa-solid fa-triangle-exclamation text-warning me-1"></i> Lưu ý khi nhập file:</div>
                        <ul class="mb-0 ps-3">
                            <li>Cột <strong>Họ tên</strong> và <strong>Tên lớp hoặc Mã lớp</strong> là bắt buộc.</li>
                            <li>Hệ thống tự động liên kết học viên cũ hoặc tạo mới nếu chưa tồn tại.</li>
                            <li>Nếu để trống học phí, hệ thống sẽ tự động áp dụng học phí mặc định của lớp học.</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                        <i class="fa-solid fa-cloud-arrow-up"></i> Bắt đầu Nhập dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
