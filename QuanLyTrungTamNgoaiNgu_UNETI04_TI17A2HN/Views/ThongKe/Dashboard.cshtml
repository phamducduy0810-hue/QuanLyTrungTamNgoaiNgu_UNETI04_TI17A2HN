@* Họ và tên: Lê Đăng Duy *@
@* Mã sinh viên: 23103100089 *@
@* Nội dung thực hiện: Module 4 - Giao diện Dashboard Admin *@
@model QuanLyTrungTamNgoaiNgu_UNETI04_TI17A2HN.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard quản trị</h2>

@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success">@TempData["ThanhCong"]</div>
}

<div class="row g-3">
    <div class="col-md-3">
        <div class="card text-white bg-primary h-100"><div class="card-body">
            <div>Tổng số khóa học</div><div class="fs-2 fw-bold">@Model.TongKhoaHoc</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info h-100"><div class="card-body">
            <div>Tổng số lớp học</div><div class="fs-2 fw-bold">@Model.TongLopHoc</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-dark h-100"><div class="card-body">
            <div>Tổng số học viên</div><div class="fs-2 fw-bold">@Model.TongHocVien</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-secondary h-100"><div class="card-body">
            <div>Tổng lượt đăng ký</div><div class="fs-2 fw-bold">@Model.TongLuotDangKy</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning h-100"><div class="card-body">
            <div>Đăng ký chờ xác nhận</div><div class="fs-2 fw-bold">@Model.DangKyChoXacNhan</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success h-100"><div class="card-body">
            <div>Đăng ký đã xác nhận</div><div class="fs-2 fw-bold">@Model.DangKyDaXacNhan</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-danger h-100"><div class="card-body">
            <div>Lớp đang tuyển sinh</div><div class="fs-2 fw-bold">@Model.LopDangTuyenSinh</div>
        </div></div>
    </div>
</div>

<div class="mt-4 d-flex gap-2">
    <a asp-controller="QuanLyDangKy" asp-action="Index" class="btn btn-outline-primary">Quản lý đăng ký</a>
    <a asp-controller="ThongKe" asp-action="Index" class="btn btn-outline-primary">Xem thống kê chi tiết</a>
</div>